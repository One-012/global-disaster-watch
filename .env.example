# Optional. The site can load public channel uploads through YouTube RSS
# even when no API key is configured.
# Never prefix a server-side API key with NEXT_PUBLIC_.
YOUTUBE_API_KEY=

# Channel used by Global Disaster Watch.
# lib/site.ts contains the same ID as a built-in fallback.
YOUTUBE_CHANNEL_ID=UCqmF4ZZG766WYtFK614swaA

# Optional: playlist owned/curated by the channel for Featured Films.
# Requires YOUTUBE_API_KEY. If blank, the 3 newest channel uploads are featured.
YOUTUBE_FEATURED_PLAYLIST_ID=

# Set your final HTTPS domain before public launch.
SITE_URL=http://localhost:3000
